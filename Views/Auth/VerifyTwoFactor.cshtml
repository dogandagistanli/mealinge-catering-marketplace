@model Ceng382_25_26_202311031.Models.TwoFactorLoginViewModel

@{
    ViewData["Title"] = "Two-Factor Verification";
}

<section class="page-header">
    <h1 class="page-title">Two-Factor Verification</h1>
    <p class="page-subtitle">Enter the email verification code sent by Mealinge.</p>
</section>

<div class="payment-form-box">
    <form asp-action="VerifyTwoFactor" method="post" class="payment-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Verification Code</label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <button type="submit" class="menu-btn">Verify Code</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}