@model List<Ceng382_25_26_202311031.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<section class="page-header">
    <h1 class="page-title">@((ViewBag.OrderScope as string) ?? "Orders")</h1>
    <p class="page-subtitle">Review completed purchases and order-connected actions.</p>
</section>

@if (!Model.Any())
{
    <div class="empty-box">
        <p>No orders found.</p>
    </div>
}
else
{
    <div class="cart-table-wrapper">

        @foreach (var order in Model)
        {
            var canUseCustomerDocuments = User.IsInRole("Admin") || order.UserId == currentUserId;
            var canRate = User.IsInRole("User") && order.UserId == currentUserId && order.Status == "Paid";

            <div class="feature-card" style="margin-bottom:20px;">

                <h3>Order #@order.Id</h3>

                <p><strong>Customer:</strong> @(order.User?.Email ?? "Customer")</p>
                <p><strong>Date:</strong> @order.OrderDate</p>
                <p><strong>Status:</strong> @order.Status</p>
                <p><strong>Total:</strong> @order.TotalAmount TL</p>

                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px;">

                    @if (canUseCustomerDocuments)
                    {
                        <a asp-controller="Orders"
                           asp-action="Receipt"
                           asp-route-id="@order.Id"
                           class="hero-btn secondary-btn">
                            Download Receipt
                        </a>

                        <a asp-controller="Orders"
                           asp-action="Agreement"
                           asp-route-id="@order.Id"
                           class="hero-btn secondary-btn">
                            Download Agreement
                        </a>
                    }

                    @if (order.Status == "Paid")
                    {
                        <a asp-controller="Calls"
                           asp-action="Order"
                           asp-route-id="@order.Id"
                           class="menu-btn">
                            Live Call
                        </a>
                    }

                </div>

                <table class="cart-table">

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Caterer</th>
                            <th>Customizations</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            @if (canRate)
                            {
                                <th>Rating</th>
                            }
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in order.OrderItems)
                        {
                            <tr>

                                <td>@item.MenuItemName</td>

                                <td>@item.CatererName</td>

                                <td>@item.SelectedCustomizations</td>

                                <td>@item.FinalUnitPrice TL</td>

                                <td>@item.Quantity</td>

                                <td>@item.Subtotal TL</td>

                                @if (canRate)
                                {
                                    <td>
                                        <a asp-controller="Ratings"
                                           asp-action="Create"
                                           asp-route-orderId="@order.Id"
                                           asp-route-orderItemId="@item.Id"
                                           class="small-btn">
                                            Rate Item
                                        </a>
                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <div style="display:flex;justify-content:center;gap:15px;margin-top:25px;">

        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               class="small-btn">
                Previous
            </a>
        }

        <span style="padding:10px 16px;">
            Page @ViewBag.CurrentPage / @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               class="small-btn">
                Next
            </a>
        }

    </div>
}
