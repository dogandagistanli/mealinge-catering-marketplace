@model Ceng382_25_26_202311031.Models.Rating

@{
    ViewData["Title"] = "Rate Order";
}

<section class="page-header">
    <h1 class="page-title">Rate Your Order</h1>
    <p class="page-subtitle">Share your experience about the menu item and caterer.</p>
</section>

<div class="payment-form-box">
    <form asp-action="Create" method="post" class="payment-form">

        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="OrderItemId" />
        <input type="hidden" asp-for="MenuItemId" />
        <input type="hidden" asp-for="MenuItemName" />
        <input type="hidden" asp-for="CatererName" />

        <div class="form-group">
            <label>Menu Item</label>
            <input value="@Model.MenuItemName" class="form-control" disabled />
        </div>

        <div class="form-group">
            <label>Caterer</label>
            <input value="@Model.CatererName" class="form-control" disabled />
        </div>

        <div class="form-group">
            <label>Menu Item Score</label>
            <input asp-for="MenuItemScore" type="number" min="1" max="5" class="form-control" />
            <span asp-validation-for="MenuItemScore" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Caterer Score</label>
            <input asp-for="CatererScore" type="number" min="1" max="5" class="form-control" />
            <span asp-validation-for="CatererScore" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Comment</label>
            <textarea asp-for="Comment" class="form-control"></textarea>
        </div>

        <button type="submit" class="menu-btn">Submit Rating</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
