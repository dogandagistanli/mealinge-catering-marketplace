@model List<Ceng382_25_26_202311031.Models.EmailRecord>

@{
    ViewData["Title"] = "Email Records";
}

<section class="page-header">
    <h1 class="page-title">Email Records</h1>
    <p class="page-subtitle">Review simulated email notifications generated by the system.</p>
</section>

<div class="feature-card" style="margin-bottom:25px;">
    <form method="get"
          asp-action="Index"
          style="display:flex;gap:15px;align-items:end;flex-wrap:wrap;">
        <div class="form-group" style="flex:1;min-width:250px;">
            <label>Search Email Records</label>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search emails..." />
        </div>

        <button type="submit"
                class="menu-btn"
                style="height:50px;">
            Search
        </button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-box">
        <p>No email records found.</p>
    </div>
}
else
{
    <div class="cart-table-wrapper">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Recipient</th>
                    <th>Subject</th>
                    <th>Body</th>
                    <th>Sent At</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var email in Model)
                {
                    <tr>
                        <td>@email.RecipientEmail</td>
                        <td>@email.Subject</td>
                        <td style="white-space:pre-wrap;">@email.Body</td>
                        <td>@email.SentAt.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div style="display:flex;justify-content:center;gap:15px;margin-top:25px;">
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   class="small-btn">
                    Previous
                </a>
            }

            <span style="padding:10px 16px;">
                Page @ViewBag.CurrentPage / @ViewBag.TotalPages
            </span>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   class="small-btn">
                    Next
                </a>
            }
        </div>
    }
}
