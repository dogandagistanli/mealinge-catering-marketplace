@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-left">
        <span class="mini-badge">Full-Stack Catering Website</span>
        <h2 class="hero-title">A modern catering platform for users, caretakers, and admins.</h2>
        <p class="hero-description">
            Discover nearby kitchens, browse customized menus, place orders, and manage every step
            in one smart platform. Mealora is designed as a clean and branded catering experience.
        </p>

        <div class="hero-buttons">
            <a href="#" class="hero-btn primary-btn">Explore Menus</a>
            <a href="#" class="hero-btn secondary-btn">Learn More</a>
        </div>
    </div>

    <div class="hero-right">
        <div class="hero-card">
            <h3>Today's Highlights</h3>
            <ul>
                <li>Nearby restaurant filtering</li>
                <li>Customizable menu options</li>
                <li>Dynamic order flow</li>
                <li>Role-based dashboards</li>
            </ul>
        </div>
    </div>
</section>

<section class="feature-grid">
    <div class="feature-card">
        <h3>User Experience</h3>
        <p>
            Users can explore menus, customize orders, track purchases, and review completed orders.
        </p>
    </div>

    <div class="feature-card">
        <h3>Caretaker Management</h3>
        <p>
            Caretakers manage menu items, upload images, define customization options, and handle activity.
        </p>
    </div>

    <div class="feature-card">
        <h3>Admin Control</h3>
        <p>
            Admins can monitor logs, inspect system activity, and keep the platform under control.
        </p>
    </div>
</section>

<section class="showcase-section">
    <div class="showcase-text">
        <h2>Built for a unique brand identity</h2>
        <p>
            This project starts with a custom visual structure instead of a plain template.
            The layout is prepared to grow into a complete catering platform with dashboards,
            ordering, rating, notifications, and document generation.
        </p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>3</h3>
            <p>Main Roles</p>
        </div>

        <div class="stat-card">
            <h3>1</h3>
            <p>Unified Platform</p>
        </div>

        <div class="stat-card">
            <h3>∞</h3>
            <p>Customization Ideas</p>
        </div>
    </div>
</section>