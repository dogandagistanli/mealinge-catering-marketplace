@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-left">
        <span class="mini-badge">Smart Catering Platform</span>
        <h2 class="hero-title">A modern catering platform for users, caterers, and admins.</h2>
        <p class="hero-description">
            Discover nearby kitchens, browse menus, place orders, and manage every step
            in one smart platform. Mealinge is designed as a clean and modern catering experience.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Menu" asp-action="Index" class="hero-btn primary-btn">Explore Menus</a>
            <a asp-controller="Dashboard" asp-action="Index" class="hero-btn secondary-btn">Open Dashboard</a>
        </div>
    </div>

    <div class="hero-right">
        <div class="hero-card">
            <h3>Today's Highlights</h3>
            <ul>
                <li>Nearby kitchen discovery</li>
                <li>Customizable menu options</li>
                <li>Simple ordering experience</li>
                <li>Role-based dashboards</li>
            </ul>
        </div>
    </div>
</section>

<section class="feature-grid">
    <div class="feature-card">
        <h3>User Experience</h3>
        <p>
            Users can browse menus, explore available food options, and manage their activity easily.
        </p>
    </div>

    <div class="feature-card">
        <h3>Caterer Management</h3>
        <p>
            Caterers can manage menu items, update food details, and organize their offerings in one place.
        </p>
    </div>

    <div class="feature-card">
        <h3>Admin Control</h3>
        <p>
            Admins can monitor the platform, manage users and caterers, and keep the system organized.
        </p>
    </div>
</section>

<section class="showcase-section">
    <div class="showcase-text">
        <h2>Designed for smarter catering management</h2>
        <p>
            Mealinge brings menus, users, caterers, and dashboard management together in a single platform.
            It is built to provide a clean experience for both customers and service providers.
        </p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>3</h3>
            <p>User Roles</p>
        </div>

        <div class="stat-card">
            <h3>1</h3>
            <p>Unified Platform</p>
        </div>

        <div class="stat-card">
            <h3>24/7</h3>
            <p>Accessible System</p>
        </div>
    </div>
</section>