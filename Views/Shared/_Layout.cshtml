<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mealora</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand-box">
                <div class="brand-logo">M</div>
                <div>
                    <h2 class="brand-title">Temporary Brand</h2>
                    <p class="brand-subtitle">Catering & Care Platform</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a href="/" class="nav-item">Home</a>
                <a href="#" class="nav-item">Nearby Kitchens</a>
                <a asp-controller="Menu" asp-action="Index" class="nav-item">Menus</a>
                <a href="#" class="nav-item">Cart</a>
                <a href="#" class="nav-item">Orders</a>
                <a href="#" class="nav-item">Dashboard</a>
                <a href="#" class="nav-item">Contact</a>
            </nav>

            <div class="sidebar-card">
                <h4>Fresh Project Start</h4>
                <p>
                    Week 1 focuses on the main visual structure, starter CSS, and the core UI shell.
                </p>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div>
                    <h1 class="topbar-title">Temporary Brand    </h1>
                    <p class="topbar-text">Order smarter. Connect faster. Manage catering easily.</p>
                </div>

                <div class="topbar-actions">
                    <a href="#" class="top-btn ghost-btn">Sign In</a>
                    <a href="#" class="top-btn solid-btn">Get Started</a>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>

            <footer class="footer">
                <div>
                    <strong>Temporary Brand</strong> © 2026 - CENG 382 Web Project
                </div>
                <div>
                    Designed for a unique catering platform experience.
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>