<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mealinge</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar">

            <div class="brand-box">
                <div class="brand-logo">M</div>

                <div>
                    <h2 class="brand-title">Mealinge</h2>
                    <p class="brand-subtitle">
                        Smart Catering Platform
                    </p>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a href="/" class="nav-item">
                    Home
                </a>

                <a asp-controller="Nearby"
                   asp-action="Index"
                   class="nav-item">
                    Nearby Kitchens
                </a>

                <a asp-controller="Menu"
                   asp-action="Index"
                   class="nav-item">
                    Menus
                </a>

                <a asp-controller="Cart"
                   asp-action="Index"
                   class="nav-item">
                    Cart
                </a>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="nav-item">
                    Orders
                </a>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item">
                    Dashboard
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Security"
                       asp-action="Index"
                       class="nav-item">
                        Security
                    </a>
                }

                @if (User.IsInRole("Caterer") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Menu"
                       asp-action="Manage"
                       class="nav-item">
                        Manage Menus
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Logs"
                       asp-action="Index"
                       class="nav-item">
                        System Logs
                    </a>

                    <a asp-controller="Emails"
                       asp-action="Index"
                       class="nav-item">
                        Email Records
                    </a>
                }

                <a href="#" class="nav-item">
                    Contact
                </a>

            </nav>

            <div class="sidebar-card">
                <h4>Platform Overview</h4>

                <p>
                    Explore menus, manage dashboard access,
                    and organize catering services in one place.
                </p>
            </div>

        </aside>

        <div class="main-area">

            <header class="topbar">

                <div>
                    <h1 class="topbar-title">Mealinge</h1>

                    <p class="topbar-text">
                        Order smarter. Connect faster.
                        Manage catering easily.
                    </p>
                </div>

                <div class="topbar-actions">

                    <button type="button"
                            id="themeToggle"
                            class="theme-toggle">
                        Dark Mode
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="top-btn ghost-btn">
                            Dashboard
                        </a>

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post"
                              style="display:inline;">

                            <button type="submit"
                                    class="top-btn solid-btn"
                                    style="border:none;">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="top-btn ghost-btn">
                            Login
                        </a>

                        <a asp-controller="Auth"
                           asp-action="Register"
                           class="top-btn solid-btn">
                            Register
                        </a>
                    }

                </div>

            </header>

            <main class="content-area">
                @RenderBody()
            </main>

            <footer class="footer">

                <div>
                    <strong>Mealinge</strong>
                    © 2026 - CENG 382 Web Project
                </div>

                <div>
                    Designed for a modern catering platform experience.
                </div>

            </footer>

        </div>

    </div>

    <script>
        (function () {

            function applyTheme() {

                const savedTheme = localStorage.getItem("theme");

                if (savedTheme === "light") {
                    document.body.classList.remove("dark-theme");
                }
                else {
                    document.body.classList.add("dark-theme");
                    localStorage.setItem("theme", "dark");
                }

                updateThemeButton();
            }

            function updateThemeButton() {

                const btn = document.getElementById("themeToggle");

                if (!btn) return;

                btn.textContent =
                    document.body.classList.contains("dark-theme")
                        ? "Light Mode"
                        : "Dark Mode";
            }

            applyTheme();

            const btn = document.getElementById("themeToggle");

            if (btn) {

                btn.addEventListener("click", function () {

                    document.body.classList.toggle("dark-theme");

                    if (document.body.classList.contains("dark-theme")) {
                        localStorage.setItem("theme", "dark");
                    }
                    else {
                        localStorage.setItem("theme", "light");
                    }

                    updateThemeButton();
                });
            }

        })();
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>