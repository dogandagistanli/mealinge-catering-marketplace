@model List<Ceng382_25_26_202311031.Models.AppLog>

@{
    ViewData["Title"] = "System Logs";
}

<section class="page-header">
    <h1 class="page-title">System Logs</h1>

    <p class="page-subtitle">
        Monitor platform activity and recent operations.
    </p>
</section>

<div class="feature-card" style="margin-bottom:25px;">

    <form method="get"
          asp-action="Index"
          style="display:flex;gap:15px;align-items:end;flex-wrap:wrap;">

        <div class="form-group" style="flex:1;min-width:250px;">

            <label>Search Logs</label>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search logs..." />

        </div>

        <button type="submit"
                class="menu-btn"
                style="height:50px;">
            Search
        </button>

    </form>

</div>

@if (!Model.Any())
{
    <div class="empty-box">
        <p>No logs found.</p>
    </div>
}
else
{
    <div class="cart-table-wrapper">

        <table class="cart-table">

            <thead>
                <tr>
                    <th>Action</th>
                    <th>User</th>
                    <th>Description</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var log in Model)
                {
                    <tr>

                        <td>@log.Action</td>

                        <td>@log.UserEmail</td>

                        <td>@log.Description</td>

                        <td>@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div style="display:flex;justify-content:center;gap:15px;margin-top:25px;">

        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-search="@ViewBag.Search"
               class="small-btn">
                Previous
            </a>
        }

        <span style="padding:10px 16px;">
            Page @ViewBag.CurrentPage / @ViewBag.TotalPages
        </span>

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               asp-route-search="@ViewBag.Search"
               class="small-btn">
                Next
            </a>
        }

    </div>
}