@model Ceng382_25_26_202311031.Models.MenuItem

@{
    ViewData["Title"] = "Create Menu";
}

<section class="page-header">
    <h1 class="page-title">Create Menu Item</h1>
    <p class="page-subtitle">Add a new food item to your catering menu.</p>
</section>

<div class="payment-form-box">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="payment-form">

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Price</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Food Image</label>
            <input type="file" name="imageFile" class="form-control" />
        </div>

        <button type="submit" class="menu-btn">Create Menu Item</button>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}